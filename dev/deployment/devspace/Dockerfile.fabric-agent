# The fabric agent: serves the fabric_agent.v1 contract and renders it onto a
# fabric controller (EDA or Hedgehog) through an in-process adapter.

FROM build-container-localdev AS builder

ENV CARGO_HOME=/cargo-home
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
ENV CARGO_TARGET_DIR=/cargo-target

WORKDIR /workspace

COPY . .

RUN --mount=type=cache,id=nico-devspace-cargo-home,target=/cargo-home,sharing=locked \
  --mount=type=cache,id=nico-devspace-cargo-target,target=/cargo-target,sharing=locked \
  cargo build -p carbide-fabric-agent --bin fabric-agent --locked && \
  mkdir -p /artifacts && \
  cp /cargo-target/debug/fabric-agent /artifacts/fabric-agent

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates \
  libssl3 \
  && rm -rf /var/lib/apt/lists/*

COPY --from=builder /artifacts/fabric-agent /usr/local/bin/fabric-agent

USER 65534:65534
EXPOSE 7443
ENTRYPOINT ["/usr/local/bin/fabric-agent"]
